
parameters:
    level: 5
    paths:
        - src
    excludePaths:
        - vendor/
        - node_modules/
        - src/logs/
        - src/images/
        - src/config.php
    bootstrapFiles:
        - phpstan-bootstrap.php
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            identifier: missingType.iterableValue
        -
            identifier: missingType.generics
        - '#Call to an undefined method mysqli::#'
        - '#Variable \$_SESSION might not be defined#'
        - '#Function session_start\(\) should be called before using \$_SESSION#'
        - '#Variable \$conn might not be defined#'